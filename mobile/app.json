{
  "expo": {
    "name": "Ventriee",
    "slug": "ventriee-mobile",
    "version": "0.1.0",
    "scheme": "ventriee",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "studios.ventriee.mobile"
    },
    "android": {
      "package": "studios.ventriee.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-status-bar"
    ],
    "extra": {
      "supabaseUrl": "",
      "supabaseKey": ""
    }
  }
}
