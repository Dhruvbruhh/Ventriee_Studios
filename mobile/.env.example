# Point the mobile app at the SAME Supabase project the desktop app uses, so it signs
# in the same users and reads the same rows. Copy to .env and fill in.
# The anon / publishable key is a public client key — never put a service_role key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
